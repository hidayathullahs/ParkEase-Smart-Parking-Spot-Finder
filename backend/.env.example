# Server Configuration
PORT=5002

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/parkease_db?retryWrites=true&w=majority

# Security (Generate using: openssl rand -hex 32)
JWT_SECRET=your_64_character_hex_jwt_secret_here
JWT_EXPIRATION=86400000

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Application Settings (Keep false for production)
APP_SEED_ENABLED=false

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
